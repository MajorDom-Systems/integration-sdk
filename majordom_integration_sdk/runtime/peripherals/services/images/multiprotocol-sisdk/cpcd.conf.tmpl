# cpcd configuration for the MajorDom multi-PAN stack, rendered to /etc/cpcd.conf by entrypoint.sh
# (mount your own /etc/cpcd.conf to skip rendering). @VAR@ placeholders come from the environment.
instance_name: cpcd_0
bus_type: UART
uart_device_file: /dev/ttyRCP
uart_device_baud: @RADIO_BAUD@
uart_hardflow: @RADIO_HARDFLOW@
bootloader_recovery_pins_enabled: false
# cpcd resets the secondary and syncs on its reset reason. On a UART without control lines that reason
# comes from a RESETn pulse (RADIO_RESET_GPIO).
reset_sequence: true
# Dev: the RCPs are built without CPC security, so disable encryption to skip the binding-key dance.
# For a hardened production image, build/flash an RCP WITH CPC security enabled and set this to false
# + provision /root/.cpcd/binding.key instead.
disable_encryption: true
stdout_trace: false
rlimit_nofile: 2000
